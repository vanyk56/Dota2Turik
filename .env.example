# [Phase: MVP v1] Railway Environment Variables Configuration
# On Railway, use Service Reference Variables so Postgres & Public Domain link automatically:
DATABASE_URL="${{Postgres.DATABASE_URL}}"
NEXT_PUBLIC_APP_URL="https://${{RAILWAY_PUBLIC_DOMAIN}}"

# Steam Web API Key (https://steamcommunity.com/dev/apikey)
STEAM_API_KEY="your_steam_web_api_key_here"

# STRATZ GraphQL API Token ([Phase: v2] optional in MVP v1)
STRATZ_TOKEN=""

# Server session secret (at least 32 characters)
SESSION_SECRET="replace_with_32_byte_random_hex_secret_key_for_sessions"

# Railway S3-Compatible Bucket (optional in dev; falls back to local public/uploads)
S3_ENDPOINT="${{Bucket.ENDPOINT}}"
S3_BUCKET="${{Bucket.BUCKET}}"
S3_ACCESS_KEY_ID="${{Bucket.ACCESS_KEY_ID}}"
S3_SECRET_ACCESS_KEY="${{Bucket.SECRET_ACCESS_KEY}}"
S3_PUBLIC_URL=""
